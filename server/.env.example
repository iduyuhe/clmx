# ====================================
# CLMX Server 环境变量配置
# 复制本文件为 .env 并修改为实际值
# ====================================

# 服务端口
PORT=3002

# JWT 密钥
# 开发：任意字符串
# 生产：openssl rand -hex 64 生成
JWT_SECRET=change-me-to-a-random-string
JWT_EXPIRES_IN=7d

# 前端地址（用于 CORS）
# 开发：http://localhost:5173
# 生产：https://your-domain.com
CLIENT_URL=http://localhost:5173

# 数据库连接（三选一）
# 方案 A — 本地 PostgreSQL（推荐，docker-compose up postgres 一键启动）
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/clmx_dev
# 方案 B — 远端 PostgreSQL（生产环境）
# DATABASE_URL=postgresql://user:password@db-host:5432/clmx_prod
# 方案 C — SQLite（仅限本地快速演示，不支持并发训练）
# DATABASE_URL=file:./dev.db

# 文件上传目录
UPLOAD_DIR=./uploads

# ── AI 引擎配置（可选，默认自动检测）──
# Python 解释器路径（训练 Worker 需要 PyTorch）
# PYTHON_PATH=/path/to/python

# 远端 GPU Worker（部署到 GPU 机器后取消注释）
# REMOTE_TRAINING_URL=http://gpu-worker:3003
# REMOTE_INFERENCE_URL=http://gpu-worker:3004

# 模型缓存目录（Transformers.js）
# MODEL_CACHE_DIR=./models_cache
