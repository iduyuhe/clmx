# ====================================
# Docker Compose 环境变量
# 复制为 .env.docker.local 填入实际值
# ====================================

# 数据库
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_on_first_run
POSTGRES_DB=clmx_dev
POSTGRES_PORT=5432

# 后端
SERVER_PORT=3002
JWT_SECRET=
CLIENT_URL=http://localhost

# 前端
CLIENT_PORT=80

# 远端 GPU Worker（可选）
# REMOTE_TRAINING_URL=http://gpu-server:3003
# REMOTE_INFERENCE_URL=http://gpu-server:3004

# Redis（可选）
REDIS_PORT=6379

# MinIO（可选）
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
